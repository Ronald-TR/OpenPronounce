{
  "name": "@openpronounce/web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Client-side OpenPronounce spike: wav2vec2 phone recognition in the browser (transformers.js + ONNX Runtime Web)",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:browser": "tsx src/bench/browser-smoke.ts",
    "bench": "tsx src/bench/node-bench.ts"
  },
  "dependencies": {
    "@diffusionstudio/vits-web": "^1.0.3",
    "@huggingface/transformers": "^3.7.6",
    "phonemizer": "^1.2.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "playwright": "^1.63.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.20.0",
    "typescript": "^5.8.0",
    "vite": "^7.1.0",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^3.2.0"
  }
}
